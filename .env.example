# ===== Obrigatórias =====
# URL base da API do Taiga (sem /api/v1 no final). Troque o exemplo pelo seu endereço.
TAIGA_URL=https://taiga-api.suaempresa.com
# Usuário de SERVIÇO: é ele que consulta o Taiga em nome de todo mundo (veja "Usuário de serviço" no README).
TAIGA_SERVICE_USER=svc-taiga-dev-view
TAIGA_SERVICE_PASSWORD=troque-esta-senha

# ===== Recomendadas em produção =====
# Chave compartilhada com o front (ele envia no cabeçalho x-api-key). Gere com: openssl rand -hex 32
# INTERNAL_API_KEY=
# 1 = confia no X-Forwarded-For enviado pelo front (IP real do cliente para o freio de login). Use em produção.
# TRUST_PROXY=1
# Endereço do SITE do Taiga (o que se abre no navegador). Habilita os links "Abrir no Taiga". Sem /project/... no final.
# TAIGA_WEB_URL=https://taiga.suaempresa.com

# ===== Opcionais (valores abaixo são os padrões) =====
# PORT=8080
# LOG_LEVEL=info
# BLOCKED_STATUS_REGEX=imped|bloquead|blocked
# DEV_ROLES=Desenvolvedor, Analista de negócio e requisitos, Analista de UX, Analista de teste de qualidade, Arquiteto, Administrador de dados, Estagiário   (* = todos)
# KANBAN_STALE_DAYS=7
# LOGIN_MAX_FAILURES=8
# LOGIN_WINDOW_MINUTES=15
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=12
# TAIGA_TIMEOUT_MS=20000
# TAIGA_MAX_CONCURRENCY=8
